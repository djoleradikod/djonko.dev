---
import Base from '../layouts/Base.astro';
import SearchBox from '../components/SearchBox.astro';
---
<Base title="Not found" noindex>
  <h1>That page isn't here</h1>
  <p>It may have moved or been renamed. The search below starts with the words from the address you followed.</p>
  <SearchBox id="nf-search" placeholder="Search the site" />
  <p id="nf-try" class="small" hidden></p>
  <p>Or start from the <a href="/">home page</a>, the <a href="/vcf/library/">VCF notes library</a> or the <a href="/vcf/paths/">reading paths</a>.</p>
  <script is:inline>
    (() => {
      // /vcf/library/upgrades/old-note-name/ -> "old note name"
      const parts = location.pathname.split('/').filter(Boolean);
      const words = (parts.at(-1) || '').replace(/\.html?$/, '').replace(/[-_]+/g, ' ').replace(/[^a-z0-9 ]/gi, '').trim();
      if (!words) return;
      const box = document.getElementById('nf-search'); box.value = words;
      const t = document.getElementById('nf-try'); const a = document.createElement('a');
      a.href = `/search/?q=${encodeURIComponent(words)}`; a.textContent = `Search for "${words}"`;
      t.append(a); t.hidden = false;
    })();
  </script>
</Base>
