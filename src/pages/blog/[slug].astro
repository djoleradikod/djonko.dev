---
import { render } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import Share from '../../components/Share.astro';
import { SITE } from '../../data/site';
import { mdxComponents } from '../../components/mdx';
import { allPosts, fmtDate, readingTime, related, tagSlug, slugOf, type Post } from '../../lib/posts';
import { personRef } from '../../lib/schema';

export async function getStaticPaths() {
  const all = await allPosts();
  return all.map((p) => ({ params: { slug: slugOf(p) }, props: { p, more: related(p, all) } }));
}
const { p, more } = Astro.props as { p: Post; more: Post[] };
const d = p.data;
const { Content, headings } = await render(p);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const url = new URL(Astro.url.pathname, Astro.site).href;
const ld = {
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: d.title, description: d.description,
  author: personRef(Astro.site), datePublished: d.pubDate.toISOString(), dateModified: (d.updated ?? d.pubDate).toISOString(),
  mainEntityOfPage: url, keywords: d.tags.join(', ') || undefined, wordCount: undefined,
  image: new URL(`/og${Astro.url.pathname.replace(/\/$/, '')}.png`, Astro.site).href,
};
---
<Base title={d.title} description={d.description} jsonLd={ld} ogType="article">
  <article data-pagefind-body>
    <header class="article-head">
      <p class="eyebrow"><a href="/blog/" style="color:inherit;text-decoration:none">Blog</a> / {d.kind}</p>
      <h1>{d.title}</h1>
      <p class="lede">{d.description}</p>
      <div class="meta">
        <span>{fmtDate(d.updated ?? d.pubDate)}</span>
        <span>{readingTime(p.body)} min read</span>
        <span>{SITE.author}</span>
        {d.tags.map((t) => <a class="badge" href={`/blog/tags/${tagSlug(t)}/`}>{t}</a>)}
      </div>
      <span hidden data-pagefind-filter="category">Blog</span>
    </header>
    {d.cover && <figure class="post-cover"><Picture src={d.cover} alt={d.coverAlt!} formats={['avif', 'webp']} widths={[800, 1200, 1600]} sizes="(min-width: 1100px) 1040px, 100vw" loading="eager" fetchpriority="high" /></figure>}
    <div class="article-layout">
      <div class="prose">
        <Content components={mdxComponents} />
        <div data-pagefind-ignore style="margin-top:2em"><Share url={url} title={d.title} /></div>
      </div>
      {toc.length > 2 && (
        <aside class="toc" data-pagefind-ignore>
          <p>On this page</p>
          <ul>{toc.map((h) => <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
        </aside>
      )}
    </div>
  </article>
  {more.length > 0 && (
    <section data-pagefind-ignore>
      <div class="section-head"><h2>Related</h2></div>
      <div class="grid">{more.map((x) => <PostCard p={x} />)}</div>
    </section>
  )}
</Base>
