---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
import { CATEGORIES } from '../data/categories';
import { KB_INDEX } from '../data/kb';
import { allArticles, urlOf } from '../lib/articles';
import { allPosts, allProjects, postUrl, projectUrl, fmtDate } from '../lib/posts';
import { personLd } from '../lib/schema';

const notes = await allArticles();
const posts = await allPosts();
const projects = await allProjects();
const latest = [
  ...posts.map((p) => ({ title: p.data.title, d: p.data.description, date: p.data.updated ?? p.data.pubDate, href: postUrl(p), kind: 'Blog' })),
  ...notes.map((a) => ({ title: a.data.title, d: a.data.description, date: a.data.updated ?? a.data.pubDate, href: urlOf(a), kind: 'VCF note' })),
].sort((a, b) => +b.date - +a.date).slice(0, 5);

const focus = [
  { t: 'Architecture and design reviews', d: 'The VCF 9 fleet, instance and domain model, identity, management services, and how a 5.x estate maps onto it.', href: '/vcf/library/architecture/' },
  { t: 'Upgrades from 5.x to 9.x', d: 'Readiness assessments, target builds, the order that matters, and runbooks with real go/no-go and rollback points.', href: '/vcf/library/upgrades/' },
  { t: 'Operations and troubleshooting', d: 'Day-2 operating models, a repeatable triage method, and escalations that arrive with the evidence attached.', href: '/vcf/library/troubleshooting/' },
  { t: 'Enablement and technical leadership', d: 'Workshops, lunch-and-learns, runbooks and decision records that leave a team able to run the platform without me.', href: '/vcf/library/leadership/' },
];
const ld = [
  personLd(Astro.site),
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: new URL('/', Astro.site).href, author: { '@id': new URL('/#person', Astro.site).href } },
];
---
<Base jsonLd={ld}>
  <section class="hero intro">
    <div>
      <p class="eyebrow">{SITE.author} · {SITE.role}</p>
      <h1>I help teams design, upgrade and run VMware Cloud Foundation.</h1>
      <p class="lede">I lead technical work on VCF 5.x and 9.x: architecture reviews, upgrade planning, day-2 operations and the hard escalations. I write down what I learn, teach it, and am building open tools for VCF Operations.</p>
      <div class="actions">
        <a class="btn primary" href="/vcf/">Read the VCF notes</a>
        <a class="btn" href="/about/">How I work</a>
        <a class="btn" href="/contact/">Get in touch</a>
      </div>
      <ul class="stats">
        <li><strong>{notes.length}</strong><span>VCF field notes</span></li>
        <li><strong>{CATEGORIES.length}</strong><span>topic areas</span></li>
        <li><strong>{KB_INDEX.length}</strong><span>KBs indexed</span></li>
        <li><strong>5</strong><span>workshop modules</span></li>
      </ul>
    </div>
    {SITE.photo && <img class="photo" src={SITE.photo} alt={`Photo of ${SITE.author}`} width="156" height="156" />}
  </section>

  <section>
    <div class="section-head"><h2>What I do</h2></div>
    <div class="grid two">
      {focus.map((f) => <a class="card" href={f.href}><h3>{f.t}</h3><p>{f.d}</p></a>)}
    </div>
  </section>

  <section>
    <div class="section-head"><h2>Selected work</h2></div>
    <div class="grid two">
      <a class="card feature" href="/vcf/">
        <span class="kicker">Knowledge base</span>
        <h3>{SITE.vcfName}</h3>
        <p>{notes.length} notes across {CATEGORIES.length} areas. Each one sets the VCF 5.x and 9.x answers side by side, links the Broadcom KBs that back it up, and credits its sources.</p>
      </a>
      <a class="card" href="/talks/">
        <span class="kicker">Enablement</span>
        <h3>A five-part VCF 9 workshop series</h3>
        <p>Architecture, upgrades, integrations, licensing and troubleshooting, built once and delivered to engineers and to customers.</p>
      </a>
      <a class="card" href="/vcf/resources/triage-cheat-sheet/">
        <span class="kicker">Method</span>
        <h3>VCF 9.x triage cheat sheet</h3>
        <p>One printable page: which layer owns a failure, where its logs are, what its errors mean, and what to attach when escalating.</p>
      </a>
      <a class="card" href="/vcf/tools/">
        <span class="kicker">Catalogue</span>
        <h3>Tools for VCF 9.x</h3>
        <p>The official, Fling and community tools worth knowing, grouped by job, with support status and a link to each publisher.</p>
      </a>
      <a class="card" href="/projects/">
        <span class="kicker">Open tools</span>
        <h3>Tools for VCF Operations</h3>
        <p>{projects.length ? `${projects.length} tool${projects.length > 1 ? 's' : ''} for VCF Operations 9.1.1 and later.` : 'Scripts, agents and management packs for VCF Operations 9.1.1 and later. The first ones are in development.'}</p>
      </a>
    </div>
  </section>

  {projects.length > 0 && (
    <section>
      <div class="section-head"><h2>Projects</h2><a class="small" href="/projects/">All projects</a></div>
      <ul class="list">
        {projects.slice(0, 4).map((p) => <li><a href={projectUrl(p)}><span class="t">{p.data.displayName}</span><span class="status">{p.data.status}</span><span class="d">{p.data.summary}</span></a></li>)}
      </ul>
    </section>
  )}

  <section>
    <div class="section-head"><h2>Latest writing</h2><span class="small"><a href="/blog/">Blog</a> · <a href="/vcf/library/">All VCF notes</a></span></div>
    <ul class="list">
      {latest.map((i) => <li><a href={i.href}><span class="t">{i.title}</span><span class="small muted">{i.kind} · {fmtDate(i.date)}</span><span class="d">{i.d}</span></a></li>)}
    </ul>
  </section>
</Base>
