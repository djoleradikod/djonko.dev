---
import Base from '../layouts/Base.astro';
---
<Base title="Search" description="Search the VCF notes, blog and project pages." noindex>
  <h1>Search</h1>
  <p class="muted">Search the VCF notes, tools catalogue, KB index, blog posts and project pages. Filter by category or VCF version. On any page, press <kbd>/</kbd> or <kbd>Ctrl</kbd>+<kbd>K</kbd> for quick search.</p>
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <label class="search-label" for="site-search">Search the site</label>
  <div id="search"></div>
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      if (window.PagefindUI) {
        const ui = new PagefindUI({ element: '#search', showSubResults: true, showImages: false, autofocus: true });
        const input = document.querySelector('#search input');
        if (input) input.id = 'site-search';
        // /search/?q=... comes from the quick search dialog ("All results") or a bookmarked search.
        const q = new URLSearchParams(location.search).get('q');
        if (q) ui.triggerSearch(q);
      }
      else document.getElementById('search').textContent = 'Search index not built yet. Run npm run build.';
    });
  </script>
</Base>
<style>.search-label { display: block; font-weight: 600; margin: 14px 0 6px; }</style>
