---
import { render } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import VersionBadges from '../../../../components/VersionBadges.astro';
import { allArticles, slugOf, urlOf, type Article } from '../../../../lib/articles';
import { categoryById } from '../../../../data/categories';
import { kbInfo } from '../../../../data/kb';
import { SITE } from '../../../../data/site';
import { personRef } from '../../../../lib/schema';
import { mdxComponents } from '../../../../components/mdx';
import Share from '../../../../components/Share.astro';
import { pathsFor } from '../../../../lib/paths';
import { kbCitations, relatedNotes } from '../../../../lib/related';
import { issueUrl } from '../../../../data/site';

export async function getStaticPaths() {
  const items = await allArticles();
  return items.map((a) => {
    const siblings = items.filter((x) => x.data.category === a.data.category);
    const i = siblings.indexOf(a);
    return { params: { category: a.data.category, slug: slugOf(a) }, props: { a, prev: siblings[i - 1], next: siblings[i + 1] } };
  });
}
interface Props { a: Article; prev?: Article; next?: Article }
const { a, prev, next } = Astro.props;
const { Content, headings } = await render(a);
const cat = categoryById(a.data.category);
const inPaths = await pathsFor(a.id);
const related = await relatedNotes(a, [prev, next, ...inPaths.map((p) => p.next)]);
const cites = await kbCitations();
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const report = issueUrl({ template: 'correction.yml', title: `Correction: ${a.data.title}`, note: pageUrl });
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const SOURCE_KIND = {
  broadcom: 'Broadcom', practitioner: 'Practitioner', press: 'Press report', analyst: 'Analyst',
  sponsored: 'Commissioned or sponsored', vendor: 'Other vendor', tracker: 'Third-party tracker', reference: 'Reference',
} as const;
const ld = {
  '@context': 'https://schema.org', '@type': 'TechArticle', headline: a.data.title, description: a.data.description,
  author: personRef(Astro.site), mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href, datePublished: a.data.pubDate.toISOString(),
  dateModified: (a.data.updated ?? a.data.pubDate).toISOString(), proficiencyLevel: a.data.level,
};
---
<Base title={a.data.title} description={a.data.description} jsonLd={ld} ogType="article">
  <article data-pagefind-body data-note={a.id}>
    <header class="article-head">
      <p class="eyebrow"><a href="/vcf/" style="color:inherit;text-decoration:none">VCF notes</a> / <a href={`/vcf/library/${cat.id}/`} style="color:inherit;text-decoration:none" data-pagefind-filter="category">{cat.short}</a></p>
      <h1>{a.data.title}</h1>
      <p class="lede">{a.data.description}</p>
      <div class="meta">
        <span data-pagefind-ignore><VersionBadges versions={a.data.versions} level={a.data.level} /></span>
        <span>{a.data.reviewed ? `Sources checked ${fmt(a.data.reviewed)}` : `Published ${fmt(a.data.updated ?? a.data.pubDate)}`}</span>
        {a.data.reviewDue && <span>Next check due {fmt(a.data.reviewDue)}</span>}
        <span>{SITE.author} · {SITE.role}</span>
      </div>
      {a.data.versions.map((v) => <span hidden data-pagefind-filter="version">{`VCF ${v}`}</span>)}
      {inPaths.map(({ path, index }) => (
        <p class="path-pos small" data-pagefind-ignore>Step {index + 1} of {path.notes.length} in the reading path <a href={`/vcf/paths/${path.id}/`}>{path.title}</a></p>
      ))}
    </header>
    <div class="article-layout">
      <div class="prose">
        <Content components={mdxComponents} />
        <div class="note-end" data-pagefind-ignore style="margin-top:2em">
          {a.data.kbs.length > 0 && (
            <details class="drawer">
              <summary>Broadcom KBs in this note ({a.data.kbs.length})</summary>
              <div class="body"><ul>
                {a.data.kbs.map((id) => {
                  const k = kbInfo(id); const others = (cites.get(id) ?? []).length - 1;
                  return <li><a href={k.url} target="_blank" rel="noopener">KB {id}</a>{k.topic && ` · ${k.topic}`}{others > 0 && <> · <a class="small" href={`/vcf/resources/kb-index/#kb-${id}`}>{others === 1 ? '1 other note' : `${others} other notes`}</a></>}</li>;
                })}
              </ul></div>
            </details>
          )}
          {a.data.sources.length > 0 && (
            <details class="drawer">
              <summary>Sources and further reading ({a.data.sources.length})</summary>
              <div class="body"><ul>
                {a.data.sources.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.title}</a>{s.by && ` · ${s.by}`}{s.date && ` · ${fmt(s.date)}`}{s.kind && <span class="src-kind"> · {SOURCE_KIND[s.kind]}</span>}</li>)}
              </ul></div>
            </details>
          )}
          {inPaths.map(({ path, index, next }) => (
            <nav class="path-next" aria-label={`Reading path: ${path.title}`}>
              <span class="small muted">Reading path · {path.title} · step {index + 1} of {path.notes.length}</span>
              {next
                ? <a href={urlOf(next)}><span>Next in this path</span>{next.data.title}</a>
                : <a href={`/vcf/paths/${path.id}/`}><span>End of the path</span>Back to {path.title}</a>}
            </nav>
          ))}
          {related.length > 0 && (
            <section class="related" aria-labelledby="related-h">
              <h2 id="related-h">Related notes</h2>
              <ul class="list">
                {related.map((r) => <li><a href={urlOf(r)}><span class="t">{r.data.title}</span><span class="d">{r.data.description}</span></a></li>)}
              </ul>
            </section>
          )}
          <Share url={pageUrl} title={a.data.title} />
          {report && <p class="small muted report">Found something wrong or out of date? <a href={report} target={report.startsWith("http") ? "_blank" : undefined} rel="noopener">Report a problem with this note</a>.</p>}
          <nav class="prev-next" aria-label="More in this category">
            {prev && <a href={urlOf(prev)}><span>Previous</span>{prev.data.title}</a>}
            {next && <a class="next" href={urlOf(next)}><span>Next</span>{next.data.title}</a>}
          </nav>
        </div>
      </div>
      {toc.length > 2 && (
        <aside class="toc" data-pagefind-ignore>
          <p>On this page</p>
          <ul>{toc.map((h) => <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
        </aside>
      )}
    </div>
  </article>
</Base>
