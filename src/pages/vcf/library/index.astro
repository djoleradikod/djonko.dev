---
import Base from '../../../layouts/Base.astro';
import ArticleList from '../../../components/ArticleList.astro';
import LibraryNav from '../../../components/LibraryNav.astro';
import { CATEGORIES } from '../../../data/categories';
import { allArticles } from '../../../lib/articles';
const items = await allArticles();
// Every note covers 9.x; the useful split is whether it also sets out the 5.x answer.
const scopes = [
  { v: 'both', label: `Compares 5.x and 9.x (${items.filter((a) => a.data.versions.includes('5.x')).length})` },
  { v: '9only', label: `9.x only (${items.filter((a) => !a.data.versions.includes('5.x')).length})` },
];
const levels = [...new Set(items.map((a) => a.data.level).filter(Boolean))] as string[];
---
<Base title="Library" description={`All ${items.length} field notes on VCF 5.x and 9.x, by category, filterable by version and level.`} shell>
  <div class="shell">
    <LibraryNav />
    <div class="lib-main" id="content-start" tabindex="-1">
      <header class="lib-head">
        <p class="note-crumbs"><a href="/vcf/">VCF notes</a></p>
        <h1>Library</h1>
        <p class="note-lede">All {items.length} notes. Filter by words, version or depth, or press <kbd>/</kbd> to search the full text.</p>
      </header>

      <div class="lib-filters">
        <label for="lq" class="sr-only">Filter titles and summaries</label>
        <input type="search" id="lq" placeholder="Filter titles and summaries, for example 'NSX'" />
        <div class="pill-row" id="lv" role="group" aria-label="Filter by VCF version">
          <button class="pill" aria-pressed="true" data-v="">Any version</button>
          {scopes.map((x) => <button class="pill" aria-pressed="false" data-v={x.v}>{x.label}</button>)}
        </div>
        {levels.length > 1 && (
          <div class="pill-row" id="ll" role="group" aria-label="Filter by depth">
            <button class="pill" aria-pressed="true" data-v="">Any depth</button>
            {levels.map((l) => <button class="pill" aria-pressed="false" data-v={l}>{l}</button>)}
          </div>
        )}
        <p class="lib-count" id="lc" aria-live="polite"></p>
      </div>

      {CATEGORIES.map((c) => {
        const mine = items.filter((a) => a.data.category === c.id);
        return (
          <section class="lib-cat">
            <div class="nr-head">
              <div>
                <h2><a href={`/vcf/library/${c.id}/`}>{c.title}</a> <span class="nr-count">{mine.length} notes</span></h2>
                <p class="nr-blurb">{c.blurb}</p>
              </div>
              <span class="nr-lab" aria-hidden="true">Versions</span>
              <span class="nr-lab" aria-hidden="true">Sources checked</span>
            </div>
            <ArticleList items={mine} searchable />
          </section>
        );
      })}
      <p id="lnone" class="muted" hidden>No notes match. Clear the filter, or press <kbd>/</kbd> to search the full text.</p>
    </div>
  </div>

  <script is:inline>
    (() => {
      const q = document.getElementById('lq'), rows = [...document.querySelectorAll('.lib-list li')], cats = [...document.querySelectorAll('.lib-cat')];
      const c = document.getElementById('lc'), none = document.getElementById('lnone');
      const f = { lv: '', ll: '' };
      // Filters survive reload and sharing through the URL: ?v=9only&l=Deep%20dive&q=nsx
      const u = new URL(location.href);
      q.value = u.searchParams.get('q') || '';
      f.lv = u.searchParams.get('v') || ''; f.ll = u.searchParams.get('l') || '';
      function apply() {
        const s = q.value.trim().toLowerCase(); let n = 0;
        rows.forEach((r) => {
          const ok = (!s || r.dataset.s.includes(s)) && (!f.lv || r.dataset.v === f.lv) && (!f.ll || r.dataset.l === f.ll);
          r.hidden = !ok; if (ok) n++;
        });
        cats.forEach((g) => { g.hidden = !g.querySelector('.lib-list li:not([hidden])'); });
        c.textContent = `${n} of ${rows.length} notes`; none.hidden = n > 0;
        const p = new URLSearchParams();
        if (s) p.set('q', q.value.trim()); if (f.lv) p.set('v', f.lv); if (f.ll) p.set('l', f.ll);
        history.replaceState(null, '', p.toString() ? `?${p}` : location.pathname);
      }
      ['lv', 'll'].forEach((id) => {
        const g = document.getElementById(id); if (!g) return;
        g.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.v === f[id])));
        g.addEventListener('click', (e) => {
          const b = e.target.closest('button'); if (!b) return;
          f[id] = b.dataset.v; g.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); apply();
        });
      });
      q.addEventListener('input', apply);
      apply();
    })();
  </script>
</Base>
