---
import Base from '../../layouts/Base.astro';
import VersionBadges from '../../components/VersionBadges.astro';
import { TOOLS, JOBS, MAKERS, type Maker } from '../../data/tools';
import { fmtDate } from '../../lib/posts';

const makers = Object.keys(MAKERS).filter((m) => TOOLS.some((t) => t.maker === m)) as Maker[];
const lastChecked = TOOLS.map((t) => t.checked).sort().at(-1)!;
const kbUrl = (n: number) => `https://knowledge.broadcom.com/external/article/${n}`;
const host = (u: string) => new URL(u).host.replace(/^www\./, '');
const ld = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Tools for VCF 9.x',
  url: new URL('/vcf/tools/', Astro.site).href,
  mainEntity: { '@type': 'ItemList', numberOfItems: TOOLS.length,
    itemListElement: TOOLS.map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: t.name, url: t.get.url })) },
};
---
<Base title="Tools for VCF 9.x" description={`${TOOLS.length} publicly available tools for planning, deploying, upgrading, diagnosing and automating VMware Cloud Foundation 9.x, grouped by job, each linked to its publisher.`} jsonLd={ld}>
  <p class="eyebrow"><a href="/vcf/" style="color:inherit;text-decoration:none">VCF notes</a></p>
  <h1>Tools for VCF 9.x</h1>
  <p class="lede">{TOOLS.length} publicly available tools, grouped by the job they do. Each entry says who publishes it, what support covers it, and what to know before running it, and links to the publisher's own page. Nothing is mirrored here, so the link always leads to the current version.</p>

  <details class="drawer">
    <summary>What the maker labels mean</summary>
    <div class="body">
      <ul>
        {makers.map((m) => <li><span class={`badge mk-${m}`}>{MAKERS[m].label}</span> {MAKERS[m].note}</li>)}
      </ul>
      <p class="small muted" style="margin:10px 0 0">Only tools anyone can download or open are listed. Tools and repositories that are internal to a vendor are left out, even when they are mentioned elsewhere. Links and facts were last confirmed on {fmtDate(new Date(lastChecked))} and every link is re-checked weekly.</p>
    </div>
  </details>

  <p><label for="tq" class="small muted" style="display:block;margin-bottom:4px">Filter by name or words</label>
    <input type="search" id="tq" placeholder="For example 'certificate', 'offline depot' or 'read-only'" /></p>
  <div class="pill-row" id="tj" role="group" aria-label="Filter by job">
    <button class="pill" aria-pressed="true" data-v="">All jobs</button>
    {JOBS.map((j) => <button class="pill" aria-pressed="false" data-v={j.id}>{j.title}</button>)}
  </div>
  <div class="pill-row" id="tm" role="group" aria-label="Filter by maker">
    <button class="pill" aria-pressed="true" data-v="">All makers</button>
    {makers.map((m) => <button class="pill" aria-pressed="false" data-v={m}>{MAKERS[m].label}</button>)}
  </div>
  <p class="small muted" id="tc" aria-live="polite"></p>

  {JOBS.map((j) => {
    const items = TOOLS.filter((t) => t.job === j.id);
    return items.length > 0 && (
      <section class="tool-group" data-job={j.id} aria-labelledby={`job-${j.id}`}>
        <h2 id={`job-${j.id}`}>{j.title}</h2>
        <p class="muted">{j.blurb}</p>
        <div class="tools">
          {items.map((t) => (
            <article class="tool" data-job={t.job} data-maker={t.maker}
              data-s={[t.name, t.publisher, t.what, t.know ?? '', ...(t.kbs ?? []).map(String)].join(' ').toLowerCase()}>
              <header>
                <h3>{t.name}</h3>
                <div class="tool-meta">
                  <span class={`badge mk-${t.maker}`} title={MAKERS[t.maker].note}>{MAKERS[t.maker].label}</span>
                  {t.versions.length > 0 ? <VersionBadges versions={t.versions} /> : <span class="badge level">Versions not stated</span>}
                </div>
                <p class="small muted pub">{t.publisher}</p>
              </header>
              <p>{t.what}</p>
              {t.know && <p class="know"><strong>Before you use it.</strong> {t.know}</p>}
              <div class="tool-links">
                <a class="btn" href={t.get.url} target="_blank" rel="noopener">{t.get.label}<span class="sr-only"> for {t.name}</span> <span class="small muted" aria-hidden="true">{host(t.get.url)}</span></a>
                {t.docs?.map((d) => <a href={d.url} target="_blank" rel="noopener">{d.label}</a>)}
                {t.kbs?.map((k) => <a href={kbUrl(k)} target="_blank" rel="noopener">KB {k}</a>)}
              </div>
            </article>
          ))}
        </div>
      </section>
    );
  })}
  <p id="tnone" class="muted" hidden>No tools match. Clear the filter or pick another job.</p>

  <p class="small muted">Missing a tool, or a link that has moved? <a href="/contact/">Send a correction</a>. To be listed, a tool must be publicly available and apply to VCF 9.x.</p>

  <script is:inline>
    (() => {
      const q = document.getElementById('tq'), cards = [...document.querySelectorAll('.tool')], groups = [...document.querySelectorAll('.tool-group')];
      const c = document.getElementById('tc'), none = document.getElementById('tnone');
      const f = { tj: '', tm: '' };
      function apply() {
        const s = q.value.trim().toLowerCase(); let n = 0;
        cards.forEach((el) => {
          const ok = (!s || el.dataset.s.includes(s)) && (!f.tj || el.dataset.job === f.tj) && (!f.tm || el.dataset.maker === f.tm);
          el.hidden = !ok; if (ok) n++;
        });
        groups.forEach((g) => { g.hidden = !g.querySelector('.tool:not([hidden])'); });
        c.textContent = `${n} of ${cards.length} tools`; none.hidden = n > 0;
      }
      ['tj', 'tm'].forEach((id) => {
        const g = document.getElementById(id);
        g.addEventListener('click', (e) => {
          const b = e.target.closest('button'); if (!b) return;
          f[id] = b.dataset.v; g.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); apply();
        });
      });
      q.addEventListener('input', apply);
      apply();
    })();
  </script>
</Base>
