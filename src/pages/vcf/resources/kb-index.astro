---
import Base from '../../../layouts/Base.astro';
import { KB_INDEX, kbInfo } from '../../../data/kb';
import { kbCitations } from '../../../lib/related';
import { urlOf } from '../../../lib/articles';
const cites = await kbCitations();
// The index, plus every KB a note cites that the index does not list yet.
const extra = [...cites.keys()].filter((n) => !KB_INDEX.some((k) => k.kb === n)).sort((a, b) => a - b).map(kbInfo);
const rows = [...KB_INDEX, ...extra];
const decks = [...new Set(KB_INDEX.flatMap((k) => k.decks))];
const cited = rows.filter((k) => cites.has(k.kb)).length;
const themeOf: Record<string, string> = {
  'Meet the fleet': 'Architecture', 'Upgrading to VCF 9.1, the right way round': 'Upgrades',
  'How it all connects': 'Integrations', 'Mind the licensing clock': 'Licensing', 'Follow the signposts': 'Troubleshooting',
};
---
<Base title="KB index" description={`${rows.length} public Broadcom KBs for VCF 9, with topics and the notes that cite each one, searchable.`}>
  <div data-pagefind-body>
  <p class="eyebrow"><a href="/vcf/" style="color:inherit;text-decoration:none">VCF notes</a> / <a href="/vcf/resources/" style="color:inherit;text-decoration:none">Resources</a></p>
  <h1>KB index</h1>
  <p class="lede">{rows.length} public Broadcom knowledge base articles on VCF 9. Each number links to the KB. The last column lists the notes on this site that cite it ({cited} KBs are cited at least once), so a KB number from a support case leads to the background as well as the fix.</p>
  <p><input type="search" id="q" placeholder="Filter by number or words, for example 'certificate' or 4431" aria-label="Filter KBs" /></p>
  <div class="pill-row" id="themes" role="group" aria-label="Filter by theme">
    <button class="pill" aria-pressed="true" data-t="">All</button>
    {decks.map((d) => <button class="pill" aria-pressed="false" data-t={themeOf[d] ?? d}>{themeOf[d] ?? d}</button>)}
    <button class="pill" aria-pressed="false" data-t="cited">Cited in a note</button>
  </div>
  <p class="small muted" id="count"></p>
  <div class="table-wrap">
    <table id="kbt">
      <thead><tr><th style="width:90px">KB</th><th>Topic</th><th style="width:150px">Theme</th><th style="width:34%">Cited in</th></tr></thead>
      <tbody>
        {rows.map((k) => {
          const th = k.decks.map((d) => themeOf[d] ?? d);
          const notes = cites.get(k.kb) ?? [];
          const tags = [...th, ...(notes.length ? ['cited'] : [])];
          return (
            <tr id={`kb-${k.kb}`} data-t={tags.join('|')}>
              <td><a href={k.url} target="_blank" rel="noopener">{k.kb}</a></td>
              <td>{k.topic || <span class="muted">Not summarised yet. See the note that cites it.</span>}</td>
              <td class="small muted">{th.join(', ')}</td>
              <td class="small">{notes.length > 0 ? <ul class="cites">{notes.map((a) => <li><a href={urlOf(a)}>{a.data.title}</a></li>)}</ul> : <span class="muted">None yet</span>}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
  <script is:inline>
    const q = document.getElementById('q'), g = document.getElementById('themes'), rows = [...document.querySelectorAll('#kbt tbody tr')], c = document.getElementById('count');
    const text = rows.map((r) => r.textContent.toLowerCase());
    let t = '';
    function apply() {
      const s = q.value.trim().toLowerCase(); let n = 0;
      rows.forEach((r, i) => { const ok = (!s || text[i].includes(s)) && (!t || r.dataset.t.split('|').includes(t)); r.hidden = !ok; if (ok) n++; });
      c.textContent = `${n} of ${rows.length} KBs`;
    }
    q.addEventListener('input', apply);
    g.addEventListener('click', (e) => { const b = e.target.closest('button'); if (!b) return; t = b.dataset.t; g.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); apply(); });
    apply();
  </script>
  </div>
</Base>
