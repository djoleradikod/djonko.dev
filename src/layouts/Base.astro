---
import '../styles/global.css';
import { SITE, indexable } from '../data/site';

interface Props { title?: string; description?: string; noindex?: boolean; jsonLd?: object | object[]; ogType?: string; ogImage?: string }
const { title, description = SITE.tagline, noindex = false, jsonLd, ogType = 'website' } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${SITE.role}`;
const path = Astro.url.pathname;
const nav = [
  { href: '/vcf/', label: 'VCF notes' },
  { href: '/blog/', label: 'Blog' },
  { href: '/projects/', label: 'Projects' },
  { href: '/talks/', label: 'Talks' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const canonical = new URL(path, Astro.site);
const robotsOff = noindex || !indexable;
// Every indexable page has a generated share card at /og/<path>.png (see src/pages/og/[...slug].png.ts).
const ogPath = Astro.props.ogImage ?? (noindex ? '/og/index.png' : `/og${path === '/' ? '/index' : path.replace(/\/$/, '')}.png`);
const ogImage = new URL(ogPath, Astro.site);
const { cloudflareToken, plausibleDomain, plausibleSrc } = SITE.analytics;
// Content Security Policy as a meta tag, so it travels with the pages to any host (Hetzner, Pages, Netlify).
// frame-ancestors cannot be set in a meta tag; the servers send X-Frame-Options instead.
const origin = (u: string) => { try { return new URL(u).origin; } catch { return ''; } };
const mediaOrigin = origin(SITE.mediaBase);
const csp = [
  "default-src 'self'",
  `script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'${cloudflareToken ? ' https://static.cloudflareinsights.com' : ''}${plausibleDomain ? ` ${origin(plausibleSrc)}` : ''}`,
  "style-src 'self' 'unsafe-inline'",
  `img-src 'self' data: blob:${mediaOrigin ? ` ${mediaOrigin}` : ''}`,
  `media-src 'self'${mediaOrigin ? ` ${mediaOrigin}` : ''}`,
  "font-src 'self' data:",
  `connect-src 'self'${cloudflareToken ? ' https://cloudflareinsights.com' : ''}${plausibleDomain ? ` ${origin(plausibleSrc)}` : ''}`,
  "frame-src 'self' https://www.youtube-nocookie.com https://player.vimeo.com",
  "object-src 'none'", "base-uri 'self'", "form-action 'self'", 'upgrade-insecure-requests',
].join('; ');
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const links = [
  SITE.links.linkedin && { href: SITE.links.linkedin, label: 'LinkedIn' },
  SITE.links.github && { href: SITE.links.github, label: 'GitHub' },
].filter(Boolean) as { href: string; label: string }[];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title ?? SITE.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0f766e" />
    {robotsOff && <meta name="robots" content="noindex" />}
    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
    <script is:inline>
      try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">JD</span>{SITE.name}</a>
        <nav class="nav" aria-label="Main">
          {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
          <a class="icon-btn" id="qs-open" href="/search/" aria-label="Search" title="Search (press / or Ctrl+K)" aria-keyshortcuts="/ Control+K Meta+K" aria-current={path.startsWith('/search/') ? 'page' : undefined}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          </a>
          <button class="icon-btn" id="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          </button>
        </nav>
      </div>
    </header>
    <main id="main">
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div><strong>{SITE.author} · {SITE.role}</strong>{links.map((l) => <> · <a href={l.href} rel="me noopener" target="_blank">{l.label}</a></>)} · <a href="/contact/">Contact</a> · <a href="/rss.xml">RSS</a></div>
        <div>{SITE.disclaimer}</div>
        <div>{SITE.affiliation} KB links point to the public Broadcom knowledge base.</div>
      </div>
    </footer>
    <dialog id="zoom" class="zoom" aria-label="Enlarged image">
      <button type="button" class="zoom-close" aria-label="Close">×</button>
      <figure><img alt="" /><figcaption hidden></figcaption></figure>
    </dialog>
    <dialog id="qs" class="qs" aria-label="Search the site">
      <form method="get" action="/search/" role="search" class="qs-bar">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <label class="sr-only" for="qs-input">Search notes, posts, tools and KBs</label>
        <input id="qs-input" name="q" type="search" autocomplete="off" spellcheck="false" placeholder="Search notes, tools, KB numbers" role="combobox" aria-expanded="false" aria-controls="qs-list" aria-autocomplete="list" />
        <button type="button" class="qs-esc" data-qs-close aria-label="Close search">Esc</button>
      </form>
      <ul id="qs-list" class="qs-list" role="listbox" aria-label="Results"></ul>
      <p class="qs-foot small muted"><span id="qs-status" aria-live="polite">Type to search. Arrow keys move, Enter opens.</span> <a id="qs-all" href="/search/">All results and filters</a></p>
    </dialog>
    <script>import '../scripts/enhance.ts';</script>
    {cloudflareToken && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: cloudflareToken })}></script>}
    {plausibleDomain && <script is:inline defer data-domain={plausibleDomain} src={plausibleSrc}></script>}
    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch (e) {}
      });
    </script>
  </body>
</html>
