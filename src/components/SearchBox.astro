---
// A search box inside a page. Without JavaScript it is a plain form to /search/; with it, typing
// opens quick search with the text carried over (see src/scripts/enhance.ts, section 4).
interface Props { placeholder?: string; id?: string }
const { placeholder = 'Search notes and KBs, or paste an error', id = 'page-search' } = Astro.props;
---
<form class="page-search" action="/search/" method="get" role="search" data-pagefind-ignore>
  <label for={id} class="sr-only">Search the site</label>
  <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
  <input type="search" id={id} name="q" placeholder={placeholder} autocomplete="off" data-qs-trigger />
  <kbd class="hint" aria-hidden="true">/</kbd>
</form>
