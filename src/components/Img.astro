---
// Optimised image with optional caption and click-to-zoom.
// Local images (imported, or ./relative in MDX) become AVIF/WebP at several widths.
// Usage in MDX:  import shot from './img/console.png';  <Img src={shot} alt="..." caption="..." />
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { mediaUrl } from '../data/site';

interface Props {
  src: ImageMetadata | string; alt: string; caption?: string; credit?: string;
  width?: number; zoom?: boolean; wide?: boolean; priority?: boolean;
}
const { src, alt, caption, credit, width, zoom = true, wide = false, priority = false } = Astro.props;
const local = typeof src !== 'string';
const full = local ? (src as ImageMetadata).src : mediaUrl(src as string);
---
<figure class:list={['fig', 'media', { wide }]}>
  {local ? (
    <Picture src={src as ImageMetadata} alt={alt} formats={['avif', 'webp']} widths={[480, 800, 1200, 1600].filter((w) => w <= (src as ImageMetadata).width).concat([(src as ImageMetadata).width]).filter((w, i, a) => a.indexOf(w) === i)}
      sizes={wide ? '(min-width: 1100px) 1040px, 100vw' : '(min-width: 900px) 720px, 100vw'} width={width}
      loading={priority ? 'eager' : 'lazy'} decoding="async" data-zoom={zoom ? full : undefined} />
  ) : (
    <img src={full} alt={alt} loading={priority ? 'eager' : 'lazy'} decoding="async" width={width} data-zoom={zoom ? full : undefined} />
  )}
  {(caption || credit) && <figcaption>{caption}{credit && <span class="credit"> {credit}</span>}</figcaption>}
</figure>
