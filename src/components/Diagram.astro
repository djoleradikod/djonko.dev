---
// Wraps an inline SVG diagram. Usage in MDX:
// <Diagram caption="..." viewBox="0 0 800 400" label="accessible description"> ...svg children... </Diagram>
interface Props { viewBox: string; label: string; caption?: string }
const { viewBox, label, caption } = Astro.props;
---
<figure class="dg">
  <div class="scroll"><svg viewBox={viewBox} role="img" aria-label={label} xmlns="http://www.w3.org/2000/svg">
    <defs>
      <marker id="arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" class="head" /></marker>
      <marker id="arra" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" class="head accent" /></marker>
    </defs>
    <slot />
  </svg></div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
