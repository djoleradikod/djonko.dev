---
// Dates one claim in running text, for facts that change: <AsOf date="2026-11-06" />
interface Props { date: string }
const { date } = Astro.props;
const d = new Date(date);
const label = d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---
<span class="as-of"><time datetime={date}>as of {label}</time></span>
