---
// 'field' is advice from practice in general. It makes no claim that the author saw the thing happen.
// 'analysis' marks reasoning of this site's own, as opposed to what a vendor or source states.
interface Props { type?: 'note' | 'warn' | 'field' | 'analysis'; title?: string }
const { type = 'note', title } = Astro.props;
const label = title ?? ({ note: 'Note', warn: 'Watch out', field: 'In practice', analysis: 'Analysis' } as const)[type];
---
<aside class={`callout ${type === 'warn' ? 'warn' : ''} ${type === 'analysis' ? 'analysis' : ''}`}><span class="label">{label}</span><slot /></aside>
