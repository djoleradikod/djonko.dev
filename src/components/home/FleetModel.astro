---
// The VCF 9 model, drawn in the clock's language: no boxes, only bars, stops and open type. Width shows what contains what. The
// fleet is one heavy bar across the page, each instance a medium bar under it, each domain a rule under that, the management
// domains' rule heavier. A pole hangs from each bar down the left edge of everything it holds, so the hierarchy reads as a comb.
// Same facts as the diagram in the note. Real text, not an SVG, so it reflows on a phone and stays at reading size. Bars and
// poles are real borders, so forced colours and print keep them.
import type { allArticles } from '../../lib/articles';
import { urlOf } from '../../lib/articles';
import Icon from '../Icon.astro';

interface Props { note: Awaited<ReturnType<typeof allArticles>>[number]; }
const { note } = Astro.props;
// The section is named by the note's title, up to its colon.
const name = note.data.title.split(':')[0].trim();
if (!name) throw new Error(`The home page names its fleet section after ${note.id}, whose title has gone.`);
---
<section class="home-sec fm" aria-labelledby="fm-h">
  <p class="home-kick">{name}</p>
  <h2 class="home-h" id="fm-h">VCF 9 puts a fleet and instances above the domains you knew from 5.x.</h2>
  <figure class="fm-fig" aria-labelledby="fm-h">
    <div class="fm-fleet">
      <div>
        <b class="fm-l">Fleet</b>
        <b class="fm-svc">VCF Operations · VCF Automation</b>
      </div>
      <div><span>Console, licensing, identity and fleet lifecycle</span></div>
    </div>
    <div class="fm-insts">
      <div class="fm-inst">
        <span class="fm-name">Instance 1</span>
        <div class="fm-doms">
          <div class="fm-dom fm-mgmt"><b>Management domain</b><span>SDDC Manager<br />vCenter · NSX<br />Services runtime</span></div>
          <div class="fm-dom"><b>Workload domain</b><span>vCenter<br />NSX</span></div>
          <div class="fm-dom"><b>Workload domain</b><span>vCenter<br />NSX</span></div>
        </div>
      </div>
      <div class="fm-inst">
        <span class="fm-name">Instance 2</span>
        <div class="fm-doms">
          <div class="fm-dom fm-mgmt"><b>Management domain</b><span>SDDC Manager<br />vCenter · NSX<br />Services runtime</span></div>
          <div class="fm-dom"><b>Workload domain</b><span>vCenter<br />NSX own</span></div>
          <div class="fm-dom"><b>Workload domain</b><span>vCenter<br />NSX shared</span></div>
        </div>
      </div>
    </div>
  </figure>
  <p class="fm-more"><a class="go" href={urlOf(note)}>Read the note <Icon name="arrow-right" size={16} /></a></p>
</section>
