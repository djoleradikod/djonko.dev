---
// The support clock, drawn to scale. Two columns: the label column holds its name and row
// names, the plot column its axis, bars and words. Two encodings: a heavy ink bar for 9.x, a thin bar in the second ink for everything
// older, plus red hatching for what nobody can plan to yet. A small key names the two bars in words true of the rows.
// "General support ends" titles the plot, because that is what every date in it means.
// There are no lines inside the plot, and each date sits right after its bar's end. It is a real table underneath:
// release, timeline, date, basis.
// src/data/releases.ts answers to the note, and the hub's build fails if the two stop agreeing.
import { summaryLine } from '../../data/decisions';
import { AXIS, CURRENT_RELEASE, NEXT_RELEASE, SUPPORT_ENDS } from '../../data/releases';
import { allArticles, urlOf } from '../../lib/articles';

interface Props { note: Awaited<ReturnType<typeof allArticles>>[number]; }
const { note } = Astro.props;

const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const t0 = Date.parse(AXIS.from), t1 = Date.parse(AXIS.to);
const at = (t: number) => ((t - t0) / (t1 - t0)) * 100;
const num = (n: number) => n.toFixed(2);
const pct = (iso: string) => `${num(at(Date.parse(iso)))}%`;

// A tick for every month on the axis; the labelled dates get a taller tick.
const majors = new Set(AXIS.ticks.map((t) => Date.parse(t.iso)));
const first = new Date(t0);
const months: number[] = [];
for (let m = first.getUTCMonth() + 1, ts = Date.UTC(first.getUTCFullYear(), m, 1); ts < t1; ts = Date.UTC(first.getUTCFullYear(), ++m, 1)) months.push(ts);
const minor = months.filter((ts) => !majors.has(ts));
const major = months.filter((ts) => majors.has(ts));
const ruler = `${minor.map((ts) => `M${num(at(ts))} 4V10`).join('')}${major.map((ts) => `M${num(at(ts))} 0V10`).join('')}`;

// 5.x, then vSphere 8, then 9.x, keeping the data's own order inside each group.
const groups = ['v5', 'other', 'v9'];
const rows = groups.flatMap((g) => SUPPORT_ENDS.filter((r) => r.family === g).map((r) => {
  const stop = r.unresolvedTo ?? r.end;
  return { ...r, vars: `--end:${pct(r.end)};--stop:${pct(stop)}${r.unresolvedTo ? `;--to:${pct(r.unresolvedTo)}` : ''}` };
}));
if (rows.length !== SUPPORT_ENDS.length) throw new Error('The support clock has a release in a family it does not draw.');

// The takeaway's first sentence is the instruction, so it gets the weight; the rest is its reason.
const [order, ...reason] = summaryLine(note.data.description).split(/(?<=\.)\s+/);
// The source line starts on the first labelled tick, so the foot lines up with the plot above it.
const footAt = (at(Date.parse(AXIS.ticks[0].iso)) / 100).toFixed(4);
---
<section class="sc" aria-labelledby="sc-h">
  <h2 class="sc-label" id="sc-h">Where things stand</h2>
  <p class="sc-key"><span><i class="old" aria-hidden="true"></i>5.x and vSphere 8</span><span><i class="new" aria-hidden="true"></i>9.x</span></p>
  <div class="sc-plot">
    <table class="sc-t" role="table">
      <caption class="sr-only">General support ends, drawn to scale from {AXIS.fromLabel}</caption>
      <thead role="rowgroup">
        <tr role="row">
          <th role="columnheader" scope="col" class="sr-only">Release</th>
          <th role="columnheader" scope="col" class="sc-axis">
            <span class="sr-only">Timeline, to scale</span>
            <span class="sc-ticks" aria-hidden="true"><span>{AXIS.fromLabel}</span>{AXIS.ticks.map((t) => <span style={`left:${pct(t.iso)}`}>{t.label}</span>)}</span>
            <svg class="sc-ruler" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true"><path d={ruler}></path></svg>
          </th>
          <th role="columnheader" scope="col" class="sc-endh">General support ends</th>
          <th role="columnheader" scope="col" class="sr-only">Basis</th>
        </tr>
      </thead>
      <tbody role="rowgroup">
        {rows.map((r) => (
          <tr role="row" class:list={['sc-r', r.family, r.unresolvedTo && 'open']} style={r.vars}>
            <th role="rowheader" scope="row" class="sc-n">{r.item}</th>
            <td role="cell" class="sc-tl"><span aria-hidden="true"><i class="sc-bar"></i>{r.unresolvedTo ? <i class="sc-span"></i> : <i class="sc-stop"></i>}</span></td>
            <td role="cell" class="sc-d"><span class="sc-dt">{r.date}</span></td>
            {r.anchor
              ? <td role="cell" class="sc-b"><a href={`${urlOf(note)}#${r.anchor}`}><span class="sc-flag">{r.basis}</span></a></td>
              : <td role="cell" class="sr-only">{r.basis}</td>}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="sc-lead"><b>{order}</b> {reason.join(' ')}</p>
  <div class="sc-facts" style={`--c:${footAt}`}>
    <dl class="sc-rel">
      <div><dt>Current release</dt><dd>{CURRENT_RELEASE.name}, <time datetime={CURRENT_RELEASE.iso}>{CURRENT_RELEASE.date}</time></dd></div>
      <div><dt>Next release</dt><dd>{NEXT_RELEASE.name}. Planned "{NEXT_RELEASE.plan}"</dd></div>
    </dl>
    <p class="sc-cap"><span><a href={urlOf(note)}>{note.data.title}</a>. {note.data.reviewed && <>Sources checked <time datetime={note.data.reviewed.toISOString().slice(0, 10)}>{fmt(note.data.reviewed)}</time>.</>}</span> <span>The end of the 9.1 bar uses the derived day, 12 Aug 2028; Broadcom states the month.</span></p>
  </div>
</section>
