---
// Two ways to use it:
//   <Compare title="..." rows={[["Topic", "5.x text", "9.x text"], ...]} />
//   <Compare title="..."><Fragment slot="v5">...</Fragment><Fragment slot="v9">...</Fragment></Compare>
// The explicit roles keep this a table for screen readers when a phone stacks its rows (see global.css).
interface Props { title?: string; rows?: [string, string, string][]; v5Label?: string; v9Label?: string }
const { title = 'What changed from 5.x', rows, v5Label = 'VCF 5.x', v9Label = 'VCF 9.x' } = Astro.props;
---
<section class="compare" aria-label={title}>
  <div class="cap">{title}</div>
  {rows ? (
    <div class="table-wrap">
      <table role="table">
        <thead role="rowgroup"><tr role="row"><td role="cell"></td><th role="columnheader" scope="col" class="v5">{v5Label}</th><th role="columnheader" scope="col" class="v9">{v9Label}</th></tr></thead>
        <tbody role="rowgroup">{rows.map(([t, a, b]) => <tr role="row"><th role="rowheader" scope="row">{t}</th><td role="cell" class="v5" data-label={v5Label} set:html={a} /><td role="cell" class="v9" data-label={v9Label} set:html={b} /></tr>)}</tbody>
      </table>
    </div>
  ) : (
    <div class="cols">
      <div class="col v5"><h4>{v5Label}</h4><slot name="v5" /></div>
      <div class="col v9"><h4>{v9Label}</h4><slot name="v9" /></div>
    </div>
  )}
</section>
